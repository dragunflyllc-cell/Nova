generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionTier {
  FREE
  PRO
  ENTERPRISE
}

/// Pre-launch email capture — separate from User, since a waitlist signup
/// isn't an account (no password, no auth) and shouldn't become one silently
/// if the same email later registers for real.
model WaitlistSignup {
  id           String   @id @default(uuid())
  email        String   @unique
  /// Optional code a prop firm partner gave this trader — lets Nova see
  /// which firms are actually driving signups before any formal partner
  /// program or benefit exists. Free text on purpose; not validated against
  /// a partner table yet, since there are no partners yet.
  propFirmCode String?
  createdAt    DateTime @default(now())

  @@map("waitlist_signups")
}

model User {
  id           String           @id @default(uuid())
  email        String           @unique
  passwordHash String
  displayName  String
  tier         SubscriptionTier @default(FREE)
  xp           Int              @default(0)
  level        Int              @default(1)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  /// Opt-IN, off by default. Nothing derived from this user's trades or
  /// behavior may be included in any enterprise/prop-firm-facing data
  /// product unless this is explicitly true — see docs/ARCHITECTURE.md's
  /// "Behavior data & consent" section before building anything that reads
  /// this flag to include a user in an export/report.
  dataSharingConsent   Boolean   @default(false)
  dataSharingConsentAt DateTime?

  refreshTokens      RefreshToken[]
  characters         UserCharacter[]
  brokerConnections  BrokerConnection[]
  tradingRules       TradingRule[]
  behaviorEvents     BehaviorEvent[]
  questCompletions   QuestCompletion[]
  evaluationAttempts EvaluationAttempt[]
  payoutRequests     PayoutRequest[]

  @@map("users")
}

enum BrokerProvider {
  TRADOVATE
  /// ProjectX Gateway (TopstepX's broker API) — self-serve API-key access,
  /// no partner approval needed. See apps/api/src/brokers/projectx.ts.
  PROJECTX
  /// Rithmic — reaches the many brokers/prop firms running on Rithmic
  /// infrastructure (not just one company). Protocol Buffers over
  /// WebSocket, no Node client exists, so this talks to a small Python
  /// sidecar (services/rithmic-sidecar) that wraps the real async_rithmic
  /// library. See apps/api/src/brokers/rithmic.ts.
  RITHMIC
  /// Not a real broker — a user typing in their own fills by hand (see
  /// apps/api/src/routes/fills.ts). Lets someone test the whole
  /// matching/behavior/rules/unlock pipeline with their real trade history
  /// today, without waiting on Tradovate partner API approval.
  MANUAL
}

/// One user's link to one broker account. Tokens are stored encrypted
/// (see apps/api/src/security/encryption.ts) — never in plaintext.
model BrokerConnection {
  id           String         @id @default(uuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     BrokerProvider
  accessToken  String
  refreshToken String?
  /// Provider-scoped account identifier (e.g. a ProjectX numeric account
  /// id) for providers where fills must be queried per-account. Unused by
  /// providers where the token alone is enough (Tradovate, MANUAL).
  externalAccountId String?
  /// Provider login/username, needed alongside refreshToken to
  /// re-authenticate (e.g. ProjectX's loginKey takes userName + apiKey).
  /// Not secret on its own — stored in plaintext.
  externalUsername   String?
  expiresAt    DateTime
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  fills BrokerFill[]

  @@unique([userId, provider])
  @@map("broker_connections")
}

/// A single raw execution pulled from a broker, stored as close to the
/// source shape as practical. Deliberately NOT the same thing as a "trade"
/// (a closed round-trip position) — matching fills into P&L-bearing trades
/// is real accounting logic (FIFO/LIFO, partials) that hasn't been built
/// yet. This table exists so that work has verified real data to build against.
model BrokerFill {
  id               String           @id @default(uuid())
  connectionId     String
  connection       BrokerConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  externalFillId   String
  contractSymbol   String
  side             String
  quantity         Int
  price            Float
  filledAt         DateTime
  raw              Json
  createdAt        DateTime         @default(now())

  @@unique([connectionId, externalFillId])
  @@index([connectionId])
  @@map("broker_fills")
}

/// A user's captured instance of a NovaDex family (e.g. "the Monkey Line").
/// `familyId` references packages/nova-dex content by id — species data
/// lives in code, not the database, so it can ship without a migration.
model UserCharacter {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId   String
  xp         Int      @default(0)
  capturedAt DateTime @default(now())

  @@unique([userId, familyId])
  @@index([userId])
  @@map("user_characters")
}

/// Refresh tokens are stored hashed, never in plaintext, and rotated on every use.
model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

/// A rule type Nova can mechanically check against a user's real matched
/// trades (apps/api/src/behavior/rules.ts owns the check logic). Deliberately
/// scoped to things verifiable from timestamps/quantity/price/P&L alone —
/// no rule type here claims to check something the data can't actually show
/// (e.g. "waited for a confirmed candle"). Freeform, non-verifiable rules are
/// a separate future feature (an AI-narrated coaching layer), not this table.
enum TradingRuleType {
  MAX_TRADES_PER_DAY
  MIN_COOLDOWN_AFTER_LOSS_MINUTES
  MAX_POSITION_SIZE
  MAX_DAILY_LOSS_POINTS
  TRADING_HOURS_WINDOW_UTC
}

/// A user-authored rule they want held accountable to. `params` shape
/// depends on `type` (see apps/api/src/behavior/rules.ts for the exact
/// schema per type) — kept as Json rather than a column per possible
/// parameter since each rule type has a different parameter shape.
model TradingRule {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      TradingRuleType
  params    Json
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())

  @@index([userId])
  @@map("trading_rules")
}

enum BehaviorSignalType {
  REVENGE_TRADE
  COOLDOWN_AFTER_LOSS
  RULE_VIOLATION
  RULE_ADHERENCE
}

/// A durable, individually-auditable record of one detected behavior signal
/// on one trade — persisted rather than only ever computed on the fly
/// (unlike the XP total in sync-xp, which recomputes from scratch each
/// call). This is the log that a future reporting/export layer would read
/// from; it exists independently of whether that layer ever gets built, and
/// independently of any user's data-sharing consent — recording it is not
/// the same as sharing it. `tradeRef` is a stable-ish identifier for the
/// trade (its closing fill id(s) joined), since trades themselves aren't
/// persisted as their own table yet (see trades/matching.ts's header).
model BehaviorEvent {
  id         String             @id @default(uuid())
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  signal     BehaviorSignalType
  tradeRef   String
  /// Empty string (not null) when this signal isn't tied to a specific
  /// user-authored rule (REVENGE_TRADE, COOLDOWN_AFTER_LOSS) — kept
  /// non-nullable on purpose so the unique constraint below actually
  /// dedupes; Postgres treats NULL as distinct from NULL, which would
  /// silently defeat this constraint for every non-rule signal.
  ruleId     String             @default("")
  detectedAt DateTime
  metadata   Json
  createdAt  DateTime           @default(now())

  @@unique([userId, signal, tradeRef, ruleId])
  @@index([userId])
  @@map("behavior_events")
}

/// One user completing one quest (apps/api/src/behavior/quests.ts owns the
/// fixed quest list and completion-check logic). Once a row exists here the
/// quest stays completed and its xpReward is never granted again — quest
/// XP is additive (unlike UserCharacter.xp, which sync-xp recomputes from
/// scratch each call), so this table is what makes "grant the reward
/// exactly once" possible.
model QuestCompletion {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questId     String
  completedAt DateTime @default(now())

  @@unique([userId, questId])
  @@index([userId])
  @@map("quest_completions")
}

/// ACTIVE -> PASSED -> (claim-funded) -> FUNDED_ACTIVE -> FUNDED_BREACHED, or
/// ACTIVE -> FAILED / FUNDED_ACTIVE -> FUNDED_BREACHED on a rule breach.
/// PASSED and FAILED are both reachable only from ACTIVE; there is no
/// profit target at the funded stage (real capital is never at risk either
/// way, so the funded stage only enforces the same daily-loss/drawdown
/// limits, same as most real evaluation-model prop firms).
enum EvaluationStatus {
  ACTIVE
  PASSED
  FAILED
  FUNDED_ACTIVE
  FUNDED_BREACHED
}

enum PayoutStatus {
  PENDING
  PAID
  DENIED
}

/// One user's run through one EvaluationTier (apps/api/src/propfirm/tiers.ts
/// holds the static tier content — fee, virtual balance, profit target, risk
/// limits — same "content in code, not a table" pattern as UserCharacter's
/// familyId referencing packages/nova-dex). Every dollar here is simulated:
/// no real broker order is ever placed against pointValueUsd, and no real
/// capital backs virtualBalanceCents. Status is recomputed from real matched
/// trades (apps/api/src/propfirm/evaluation.ts) on every
/// POST /me/propfirm/attempts/:id/sync call — idempotent, same pattern as
/// sync-xp and /me/rules/check.
model EvaluationAttempt {
  id       String @id @default(uuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tierId   String
  /// Trader-declared dollars-per-point for the contract they intend to
  /// trade — Nova has no per-contract tick-value reference table yet (see
  /// docs/ARCHITECTURE.md's "Dollar P&L" note on trade matching), so this
  /// is self-declared, not verified against broker data.
  pointValueUsd Float
  status        EvaluationStatus @default(ACTIVE)
  /// Start of the CURRENT stage's rule window (daily-loss/drawdown/min-days
  /// are all measured from here) — reset to the claim-funded timestamp when
  /// moving ACTIVE -> FUNDED_ACTIVE, since the funded stage gets its own
  /// fresh virtual balance and window, not a continuation of the evaluation's.
  startedAt          DateTime  @default(now())
  evaluationPassedAt DateTime?
  fundedAt           DateTime?
  /// Set when the attempt reaches a terminal state (FAILED or FUNDED_BREACHED).
  endedAt            DateTime?
  /// Cumulative raw (pre-split) profit already accounted for by a PAID
  /// payout — the baseline the next payout's payable amount is computed
  /// against, so the same gain is never paid out twice. Increases only on
  /// payout approval, not on payout request.
  paidProfitCents Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  payoutRequests PayoutRequest[]

  @@index([userId])
  @@map("evaluation_attempts")
}

/// A funded-stage trader's request to cash out their share of profit earned
/// since the last payout (or since going funded, if this is the first).
/// Approval (PENDING -> PAID) is a manual/back-office action in this v1 —
/// there is no real payment processor wired up yet (see
/// docs/ARCHITECTURE.md), so `status` records the firm's payout ledger
/// intent, not a completed real-money transfer.
model PayoutRequest {
  id                  String            @id @default(uuid())
  userId              String
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  evaluationAttemptId String
  evaluationAttempt   EvaluationAttempt @relation(fields: [evaluationAttemptId], references: [id], onDelete: Cascade)
  amountCents         Int
  status              PayoutStatus      @default(PENDING)
  requestedAt         DateTime          @default(now())
  resolvedAt          DateTime?

  @@index([userId])
  @@index([evaluationAttemptId])
  @@map("payout_requests")
}
