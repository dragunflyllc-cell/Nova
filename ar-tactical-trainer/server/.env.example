DATABASE_URL="file:./dev.db"
PORT=4100
MEDIA_STORAGE_DIR="./data/media"

# Dev mode (default): every request acts as one fixed org/admin, no login
# needed anywhere. Set to "false" once you're ready for real per-agency
# accounts — you'll also want to set a real ACCESS_TOKEN_SECRET below.
DISABLE_AUTH=true

# Only read when DISABLE_AUTH=false. Any long random string.
# ACCESS_TOKEN_SECRET=
