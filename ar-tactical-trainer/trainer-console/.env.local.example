NEXT_PUBLIC_API_URL="http://localhost:4100"
NEXT_PUBLIC_WS_URL="ws://localhost:4100/ws"

# Dev mode (default): no login screen, every page just works. Must match
# the server's own DISABLE_AUTH (server/.env) — set both to "false"
# together when you're ready for real per-agency accounts.
NEXT_PUBLIC_AUTH_DISABLED=true
